{
  "bar": {
    "centerAnchor": "ramzal.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "ramzal.indicators"
        },
        {
          "id": "ramzal.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "sunday"
        },
        {
          "alertMinIntensity": "Moderate",
          "alertRadiusKm": 100,
          "alertsEnabled": true,
          "id": "eduardodallecort.weather-radar"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omamail"
        }
      ],
      "left": [
        {
          "id": "ramzal.menu"
        },
        {
          "id": "ramzal.workspaces"
        },
        {
          "id": "ianswope.apple-music"
        },
        {
          "id": "anders.appletv-remote",
          "identifier": "8E:6F:7F:24:F5:C1",
          "maskTextPreview": false,
          "shortcuts": "{}"
        },
        {
          "id": "io.weirdware.blueferry"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "akitaonrails.ai-usagebar",
