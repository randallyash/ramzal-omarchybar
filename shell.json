          "provider": "",
          "showAll": true,
          "showProvider": false,
          "showValue": true
        },
        {
          "id": "ramzal.tray",
          "pinned": [
            "steam"
          ],
          "hidden": [
            "z13-power",
            "z13-power-service"
          ]
        },
        {
          "id": "io.github.corck.filesearch"
        },
        {
          "id": "ollywarren.prompt-guide"
        },
        {
          "id": "slw.keyarchy",
          "enabled": false,
          "categories": {
            "window": true,
            "workspace": true,
            "launch": true,
            "focus": true
          }
        },
        {
          "id": "ussego.otoru"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "ramzal.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "ramzal.monitor"
        },
        {
          "id": "z13.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
