{
  "bar": {
    "centerAnchor": "ramzal.clock",
    "layout": {
      "center": [
        {
          "id": "ramzal.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "ramzal.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "alertMinIntensity": "Moderate",
          "alertRadiusKm": 100,
          "alertsEnabled": true,
          "id": "eduardodallecort.weather-radar"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ramzal.menu"
        },
        {
          "id": "ramzal.workspaces"
        },
        {
          "id": "ianswope.apple-music"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "ramzal.tray",
          "pinned": [
            "steam"
          ],
          "hidden": [
            "z13-power",
            "z13-power-service"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "ramzal.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "z13.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 480,
    "screensaver": 240,
    "sleep": 900
  },
  "plugins": [
    {
      "id": "ramzal.bar-icons"
    },
    {
      "id": "z13.battery"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.battery",
    "omarchy.power",
    "ramzal.power",
    "ramzal.battery"
  ],
  "cloneSourceRestores": [
    "ramzal.battery"
  ]
}
